# Copiá este archivo a .env y completá tus valores. NUNCA subas el .env al repo.
# Todas estas variables se validan al arrancar (lib/env.ts): si falta alguna, el error te dice cuál.

# Postgres (Neon recomendado: https://neon.tech). Usá la cadena de conexión con sslmode=require.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Secreto de Better Auth, mínimo 32 caracteres. Generalo con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (en local http://localhost:3000; en producción el dominio real)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (opcional): si faltan, el botón de Google queda deshabilitado.
# URL de redirección autorizada: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Superadmins: correos separados por coma. Entran por /admin/login.
# Con Google, el correo verificado de esta lista recibe el rol admin.
ADMIN_EMAILS=admin@ejemplo.com

# Opcional: contraseña para crear los admins de ADMIN_EMAILS con `npm run db:admins`
# (útil mientras no esté configurado Google). Mínimo 12 caracteres.
ADMIN_SEED_PASSWORD=
